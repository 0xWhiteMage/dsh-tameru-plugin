{
  "name": "dsh-tameru",
  "version": "0.2.0",
  "description": "Tameru for DeepSeek Harness: shortens bulky tool output before it fills the context, keeps every error, and lets you pin, keep and restore. Local, no extra model calls.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "context",
    "compaction",
    "agents"
  ],
  "homepage": "https://github.com/0xWhiteMage/dsh-tameru-plugin#readme",
  "bugs": {
    "url": "https://github.com/0xWhiteMage/dsh-tameru-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xWhiteMage/dsh-tameru-plugin.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/",
    "vendor/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-timeout=120000 \"test/*.test.ts\"",
    "check:vendored": "python scripts/check_vendored.py",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
